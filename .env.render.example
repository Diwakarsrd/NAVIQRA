# Configure these in Render Dashboard > Environment. Never commit real values.
NAVIQRA_ENV=production
NAVIQRA_DOCS=false
NAVIQRA_ENABLE_LEGACY_V1=false
NAVIQRA_DB_AUTO_CREATE=false
NAVIQRA_LOG_LEVEL=INFO
NAVIQRA_MAX_REQUEST_BYTES=1048576
# Render can generate this secret. If setting manually, use a unique 48+ byte random value.
NAVIQRA_API_KEY=<GENERATE_IN_RENDER>
# Supabase Session Pooler URI; URL-encode special characters in the password.
NAVIQRA_DATABASE_URL=postgresql://naviqra_runtime.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-prod-ca.crt
# JSON: tenant id -> list of SHA-256 hashes. Store only hashes here.
NAVIQRA_TENANT_KEY_HASHES={"demo":["<64_CHAR_LOWERCASE_SHA256>"]}
# Include the Render hostname and any custom API hostname.
NAVIQRA_ALLOWED_HOSTS=naviqra-api.onrender.com,api.example.com
# Exact HTTPS origins only; use []/empty only if no browser frontend calls this API.
NAVIQRA_CORS_ORIGINS=https://app.example.com
